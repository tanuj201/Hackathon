# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter — required for AI chat & studio tools
OPENROUTER_API_KEY=your-openrouter-api-key

# Text-to-Speech (optional — for Audio Overview)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
OPENAI_API_KEY=your-openai-api-key

# Site URL — set to your Vercel domain in production
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
NEXT_PUBLIC_SITE_NAME=CogniDrive

# Cloud storage quota in MB (default 1024 = 1 GB). Set 2048 for 2 GB, etc.
MAX_STORAGE_MB=1024

# ─────────────────────────────────────────────────────────────
# VERCEL DEPLOY CHECKLIST
# 1. Add ALL variables above in Vercel → Project → Settings → Environment Variables
# 2. Apply to Production, Preview, and Development
# 3. Redeploy after saving (Deployments → ⋯ → Redeploy)
# 4. In Supabase SQL Editor, run: supabase/schema.sql
# 5. In Supabase Storage, create bucket: cognidrive-files (private)
# 6. Optional: run supabase/storage-policies.sql if uploads fail
# 7. Visit https://YOUR_APP.vercel.app/api/status to verify all checks pass
