# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter — required for AI chat & studio tools
OPENROUTER_API_KEY=your-openrouter-api-key

# Text-to-Speech (optional — for Audio Overview MP3)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
OPENAI_API_KEY=your-openai-api-key

# Launch period — set FREEMIUM_ENABLED=true when Stripe/PAN ready
FREEMIUM_ENABLED=false
LAUNCH_FREE_UNTIL=2026-09-03

# Stripe — optional during launch; required when FREEMIUM_ENABLED=true
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
STRIPE_PRICE_PRO_MONTHLY=price_...   # $1.99/month in Stripe Dashboard
STRIPE_PRICE_PRO_YEARLY=price_...    # $19.99/year in Stripe Dashboard
STRIPE_COUPON_EDU=                   # optional .edu discount coupon ID

# Site URL — your custom domain on Vercel
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
NEXT_PUBLIC_SITE_NAME=CogniDrive

# Cloud storage quota override for legacy env (per-plan limits apply when auth enabled)
MAX_STORAGE_MB=1024

# ─────────────────────────────────────────────────────────────
# SETUP CHECKLIST
# 1. Run supabase/schema.sql then supabase/schema-v2-auth-billing.sql
# 2. Enable Google OAuth in Supabase Auth providers (optional)
# 3. Set FREEMIUM_ENABLED=false and LAUNCH_FREE_UNTIL for launch month
# 4. When PAN ready: create Stripe products ($1.99/mo, $19.99/yr), set FREEMIUM_ENABLED=true
# 5. Stripe webhook: https://YOUR_APP/api/stripe/webhook
#    Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
# 6. Add all env vars in Vercel → Redeploy
# 7. Custom domain in Vercel → update NEXT_PUBLIC_SITE_URL
